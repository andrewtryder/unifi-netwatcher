# Application (production defaults — safe for Docker / Portainer)
# Leave APP_SECRET_KEY empty to generate/persist data/app-secret.key (mode 0600)
# on first start. Or set a non-placeholder secret of at least 16 characters.
APP_ENV=production
APP_SECRET_KEY=
# APP_SECRET_KEY_PATH=data/app-secret.key
DATABASE_URL=sqlite:///./data/netwatcher.db

# UniFi Controller / UniFi Network Server
# For a real controller: set URL/credentials and UNIFI_MOCK_MODE=false.
# Placeholder passwords are rejected in production when not using mock mode.
UNIFI_URL=https://unifi.example.local
UNIFI_USERNAME=netwatcher
UNIFI_PASSWORD=change-me
UNIFI_SITE=default
UNIFI_VERIFY_SSL=true
# Optional path to a CA bundle for self-signed UniFi controllers (used when VERIFY_SSL=true).
# UNIFI_CA_BUNDLE=/certs/unifi-ca.pem
UNIFI_TIMEOUT_SECONDS=10

# Scanner
SCAN_INTERVAL_SECONDS=300
ALERT_COOLDOWN_SECONDS=21600

# Retention (0 = never prune; Tools Web UI can override)
OBSERVATION_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=90

# Blocking
UNIFI_DRY_RUN_BLOCKS=true

# Set false when connecting to a real UniFi controller.
UNIFI_MOCK_MODE=false

# Comma-separated hostnames allowed for outbound webhooks (optional allowlist bypass for SSRF checks).
# WEBHOOK_ALLOWED_HOSTS=hooks.example.com

# Behind an HTTPS reverse proxy, set the public browser origin for same-origin checks:
# PUBLIC_ORIGIN=https://netwatcher.home.arpa

# Emergency: bypass CIDR and trusted-host restrictions (does not disable auth or reset passwords).
# SECURITY_RECOVERY_BYPASS=false
