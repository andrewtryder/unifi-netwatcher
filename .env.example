# Application
APP_ENV=production
# Used to encrypt notification channel secrets at rest (change in production).
APP_SECRET_KEY=change-me
DATABASE_URL=sqlite:///./data/netwatcher.db

# UniFi Controller / UniFi Network Server
UNIFI_URL=https://unifi.example.local
UNIFI_USERNAME=netwatcher
UNIFI_PASSWORD=change-me
UNIFI_SITE=default
# Verify controller TLS (default true). For a private CA, set UNIFI_CA_BUNDLE to a PEM path.
UNIFI_VERIFY_SSL=true
# UNIFI_CA_BUNDLE=/certs/unifi-ca.pem
# Only set the next flag for trusted lab networks when verification cannot be enabled:
# UNIFI_ALLOW_INSECURE_SSL=false
UNIFI_TIMEOUT_SECONDS=10

# Scanner
SCAN_INTERVAL_SECONDS=300
ALERT_COOLDOWN_SECONDS=21600

# Retention (0 = never prune; Tools Web UI can override)
OBSERVATION_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=90

# Comma-separated hostnames allowed for outbound HTTPS webhooks (required for webhook channels)
# WEBHOOK_ALLOWED_HOSTS=hooks.example.com,api.pushover.net

# Blocking
UNIFI_DRY_RUN_BLOCKS=true

# Demo / development only — set true to use fixture data instead of a real controller.
# compose.dev.yml sets this automatically for Docker-based local development.
UNIFI_MOCK_MODE=false

# Emergency CIDR bypass only (does not disable auth or reset passwords).
# SECURITY_RECOVERY_BYPASS=false
