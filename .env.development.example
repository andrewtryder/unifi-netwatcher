# Local development (native uv / Node). Do not use for production Docker.
# Docker Compose: prefer `compose.yml` + `compose.dev.yml` (sets APP_ENV / mock).
APP_ENV=development
APP_SECRET_KEY=dev-only-secret-key-change-me
# APP_SECRET_KEY_PATH=data/app-secret.key
DATABASE_URL=sqlite:///./data/netwatcher.db

# UniFi Controller / UniFi Network Server
UNIFI_URL=https://unifi.example.local
UNIFI_USERNAME=netwatcher
UNIFI_PASSWORD=change-me
UNIFI_SITE=default
UNIFI_VERIFY_SSL=true
# UNIFI_CA_BUNDLE=/certs/unifi-ca.pem
UNIFI_TIMEOUT_SECONDS=10

SCAN_INTERVAL_SECONDS=300
ALERT_COOLDOWN_SECONDS=21600
DEVICE_OFFLINE_MISSED_SCANS=2
DEVICE_OFFLINE_GRACE_SECONDS=600

# Behavioral Notification Rules (all disabled by default; Notifications Web UI can override)
# NOTIFY_DEVICE_DISCONNECTED=false
# NOTIFY_DEVICE_RECONNECTED=false
# NOTIFY_DEVICE_SSID_CHANGED=false
# NOTIFY_DEVICE_AP_CHANGED=false
# NOTIFY_DEVICE_NETWORK_CHANGED=false
# BEHAVIORAL_ALERT_COOLDOWN_SECONDS=3600

OBSERVATION_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=90

UNIFI_DRY_RUN_BLOCKS=true

# Fixture data instead of a real controller.
UNIFI_MOCK_MODE=true

# WEBHOOK_ALLOWED_HOSTS=hooks.example.com
# PUBLIC_ORIGIN=https://netwatcher.home.arpa
# SECURITY_RECOVERY_BYPASS=false
